<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    styleClass="dialog-content">

    <VBox>
        <Label fx:id="titleLabel" text="Resource Content" styleClass="dialog-title" />
    </VBox>

    <TextArea fx:id="contentArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
        styleClass="text-area" />

    <VBox styleClass="button-container" spacing="8">
        <Button fx:id="editButton" text="Edit" styleClass="secondary-btn" maxWidth="Infinity"
            onAction="#handleEdit" />
        <Button fx:id="saveButton" text="Save" styleClass="primary-btn" maxWidth="Infinity"
            onAction="#handleSave" visible="false" managed="false" />
        <Button fx:id="cancelButton" text="Cancel" styleClass="secondary-btn" maxWidth="Infinity"
            onAction="#handleCancel" visible="false" managed="false" />
        <Button text="Close" styleClass="secondary-btn" maxWidth="Infinity" onAction="#handleClose" />
    </VBox>
</VBox>