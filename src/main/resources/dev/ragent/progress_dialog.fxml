<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    alignment="CENTER" styleClass="dialog-content">

    <Label fx:id="statusLabel" text="Importing files..." styleClass="dialog-title" />

    <ProgressBar fx:id="progressBar" progress="0" styleClass="progress-bar" />

    <Label fx:id="detailLabel" styleClass="dialog-detail" />
</VBox>