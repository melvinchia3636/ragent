<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    styleClass="dialog-content">

    <!-- Appearance Section -->
    <VBox>
        <Label text="Appearance" styleClass="dialog-section-title" />

        <HBox alignment="CENTER_LEFT" styleClass="dialog-option-row">
            <CheckBox fx:id="darkModeCheckBox" text="Dark Mode" styleClass="dialog-checkbox" />
            <Label text="Enable dark theme for the application" styleClass="dialog-hint" />
        </HBox>
    </VBox>

    <!-- Buttons -->
    <HBox styleClass="button-container">
        <Button fx:id="cancelButton" text="Cancel" styleClass="secondary-btn"
            onAction="#handleCancel" />
        <Button fx:id="saveButton" text="Save" styleClass="primary-btn"
            onAction="#handleSave" />
    </HBox>
</VBox>