<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
    spacing="0" styleClass="message-details-dialog">

    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- Context References Tab -->
        <Tab text="Context References">
            <ScrollPane fitToWidth="true" fitToHeight="true">
                <VBox fx:id="contextContainer" spacing="12" styleClass="context-container">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16" />
                    </padding>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- Query Variations Tab -->
        <Tab text="Query Variations">
            <ScrollPane fitToWidth="true" fitToHeight="true">
                <VBox fx:id="variationsContainer" spacing="8" styleClass="variations-container">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16" />
                    </padding>
                </VBox>
            </ScrollPane>
        </Tab>

    </TabPane>

    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="dialog-buttons">
        <Button text="Close" onAction="#handleClose" styleClass="secondary-btn" maxWidth="Infinity"
            HBox.hgrow="ALWAYS" />
    </HBox>

</VBox>