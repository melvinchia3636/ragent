<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<fx:root type="VBox" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    alignment="CENTER" spacing="0">

    <!-- Session List Scroll Pane -->
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
        prefHeight="-1.0" prefWidth="-1.0" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets bottom="20" />
        </VBox.margin>
        <VBox fx:id="sessionListContainer" />
    </ScrollPane>

    <VBox alignment="CENTER" fx:id="buttonContainer">
        <Button fx:id="newSessionButton" text="New Session"
            styleClass="primary-btn" maxWidth="Infinity"
            mnemonicParsing="false" onAction="#handleNewSession" />
        <Button fx:id="preferencesButton" text="Preferences"
            styleClass="secondary-btn" maxWidth="Infinity"
            mnemonicParsing="false" onAction="#handleOpenPreferences" />
    </VBox>
</fx:root>