<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25"
   xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.assignment.MainController">
   <children>
      <SplitPane dividerPositions="0.25111358574610243" focusTraversable="true" prefHeight="-1.0"
         prefWidth="-1.0" VBox.vgrow="ALWAYS">
         <items>
            <dev.assignment.view.SessionSidebar fx:id="sessionSidebar"
               SplitPane.resizableWithParent="false" />
            <VBox>
               <children>
                  <HBox alignment="CENTER">
                     <children>
                        <VBox>
                           <children>
                              <Label fx:id="sessionNameLabel" text="No Session Selected">
                                 <font>
                                    <Font name="System Italic" size="18.0" />
                                 </font>
                              </Label>
                              <Label fx:id="sessionCreatedLabel" text="" textFill="#909090" />
                              <Label text="Model: GPT 5o" textFill="#909090" />
                           </children>
                        </VBox>
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleManageKnowledgebase"
                           text="Manage Knowledgebase">
                           <graphic>
                              <ImageView fitHeight="150.0" fitWidth="18.0" pickOnBounds="true"
                                 preserveRatio="true">
                                 <image>
                                    <Image url="@uil--books.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                     </children>
                     <VBox.margin>
                        <Insets bottom="20.0" />
                     </VBox.margin>
                  </HBox>
                  <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER"
                     pannable="true" prefHeight="200.0" prefWidth="200.0"
                     style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <content>
                        <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308"
                           maxWidth="1.7976931348623157E308" spacing="6.0">
                           <children>
                              <HBox alignment="CENTER_RIGHT">
                                 <children>
                                    <Label
                                       style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: lightgrey; -fx-border-radius: 4;"
                                       text="Who is Melvin Chia?">
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                       <HBox.margin>
                                          <Insets />
                                       </HBox.margin>
                                    </Label>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label
                                       style="-fx-background-color: lightgrey; -fx-background-radius: 4; -fx-border-color: grey; -fx-border-radius: 4;"
                                       text="A nerd who has a decently big brain and loves doing cool projects.">
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                       <HBox.margin>
                                          <Insets />
                                       </HBox.margin>
                                    </Label>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_RIGHT" layoutX="10.0" layoutY="10.0">
                                 <children>
                                    <Label
                                       style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: lightgrey; -fx-border-radius: 4;"
                                       text="How old is he?">
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                       <HBox.margin>
                                          <Insets />
                                       </HBox.margin>
                                    </Label>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="49.0">
                                 <children>
                                    <Label
                                       style="-fx-background-color: lightgrey; -fx-background-radius: 4; -fx-border-color: grey; -fx-border-radius: 4;"
                                       text="He is turning 20 next year.">
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                       <HBox.margin>
                                          <Insets />
                                       </HBox.margin>
                                    </Label>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_RIGHT">
                                 <children>
                                    <Label
                                       style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: lightgrey; -fx-border-radius: 4;"
                                       text="Which course is he studying in university?">
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                       <HBox.margin>
                                          <Insets />
                                       </HBox.margin>
                                    </Label>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label text="Getting responses..." textFill="#0000008b" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
                  <HBox>
                     <children>
                        <TextField promptText="Enter your prompt here..." HBox.hgrow="ALWAYS"
                           style="-fx-padding: 10 15 10 15; -fx-focus-color: #409EFF;">
                           <HBox.margin>
                              <Insets right="10.0" />
                           </HBox.margin>
                        </TextField>
                        <Button mnemonicParsing="false" text="Send"
                           style="-fx-padding: 10 20 10 20;" />
                     </children>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </items>
      </SplitPane>
      <HBox id="HBox" alignment="CENTER_LEFT" spacing="5.0">
         <children>
            <Label maxHeight="1.7976931348623157E308" maxWidth="-1.0"
               text="Fetching responses from the LLM..." HBox.hgrow="ALWAYS">
               <font>
                  <Font size="11.0" fx:id="x3" />
               </font>
               <textFill>
                  <Color red="0.625" green="0.625" blue="0.625" fx:id="x4" />
               </textFill>
            </Label>
            <Pane prefHeight="-1.0" prefWidth="-1.0" HBox.hgrow="ALWAYS" />
            <Label font="$x3" maxWidth="-1.0" text="Right status" textFill="$x4" HBox.hgrow="NEVER" />
         </children>
         <padding>
            <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
         </padding>
      </HBox>
   </children>
</VBox>